#!/usr/bin/env bash
# ccm-openspec-scope: check a Reeve spec ticket's branch against the file rules
# Reeve's merge gate applies to it, and print the verdict as JSON.
#
# Usage: ccm-openspec-scope [--worktree] CHANGE SECTION BASE
#        ccm-openspec-scope --precheck --repo OWNER/NAME CHANGE SECTION
#
# CHANGE is the OpenSpec change name, SECTION a section number or "archive"
# ("parent" only with --precheck, which refuses it), BASE the PR's base branch
# (a ref such as origin/main or main).
#
# Scope mode compares what the branch holds against BASE the way the gate
# does: the paths the PR touches come from the merge base of BASE and HEAD
# (the files GitHub lists for the PR), and tasks.md and the change folder are
# compared against the tip of BASE, the file that would land. By default the
# branch is HEAD; with --worktree it is HEAD plus the uncommitted changes and
# deletions of tracked files, the new files staged in the index, and the
# untracked, not ignored files under openspec/: what the branch holds once the
# work is committed. Only regular files and symlinks are staged, so a device
# (a sandbox's /dev/null mount over a dotfile) or FIFO is skipped. Untracked
# files outside openspec/ are left out: the section rules judge only openspec/
# paths, openspec archive writes only under openspec/, and session files such
# as .claude/settings.local.json are never committed. The first rule that
# fails is reported.
#   Section rules: outside-section, tasks-unreadable, section-missing,
#     tasks-text, tasks-unchecked.
#   Archive rules: not-moved, folder-content, tasks-unreadable (the archived
#     tasks.md does not parse), tasks-unchecked, outside-archive,
#     specs-unchanged, specs-changed, spec-deleted.
# The gate's record-tasks rule is not here: the run record does not exist yet.
#
# Precheck mode checks the checkout before any work: section-parent,
# repo-unknown, repo-mismatch, tasks-missing, archive-exists (archive only),
# tasks-unreadable, section-missing (sections only).
#
# Exit codes: 0 pass, 1 a rule failed, 3 cannot read the repository or BASE,
# 4 usage error.
# Output: {pass, mode, change, section, rule, detail, file, line, task_id,
#          tasks, unchecked, tasks_done, base, merge_base}

set -euo pipefail
here=$(dirname "${BASH_SOURCE[0]}")
# shellcheck source=bin/ccm-lib.sh
. "$here/ccm-lib.sh"

usage() { echo "ccm-openspec-scope: $1" >&2; exit 4; }

precheck=false worktree=false repo="" args=()
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) sed -n '2,39p' "$0"; exit 0 ;;
    --precheck) precheck=true ;;
    --worktree) worktree=true ;;
    --repo) [ $# -ge 2 ] || usage "--repo needs OWNER/NAME"; repo=$2; shift ;;
    --repo=*) repo=${1#--repo=} ;;
    -*) usage "unknown flag $1" ;;
    *) args+=("$1") ;;
  esac
  shift
done

change=${args[0]:-} section=${args[1]:-} base=${args[2]:-}
if [ "$precheck" = true ]; then
  [ ${#args[@]} -eq 2 ] || usage "--precheck takes CHANGE and SECTION"
  [ -n "$repo" ] || usage "--precheck needs --repo OWNER/NAME"
  [ "$worktree" = false ] || usage "--worktree does not apply to --precheck"
else
  [ ${#args[@]} -eq 3 ] || usage "takes CHANGE, SECTION, and BASE"
  [ -z "$repo" ] || usage "--repo applies only to --precheck"
fi
[[ $change =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || usage "change $(printf %q "$change") is not a kebab-case name"
case $section in
  archive) ;;
  parent) [ "$precheck" = true ] || usage "section parent carries no work to check" ;;
  *) [[ $section =~ ^[0-9]{1,15}$ ]] || usage "section $(printf %q "$section") is not a number, archive, or parent"
     section=$((10#$section)) ;;
esac

if [ "$precheck" = true ]; then mode=precheck; elif [ "$section" = archive ]; then mode=archive; else mode=section; fi
dir="openspec/changes/$change"
tasks_path="$dir/tasks.md"

top=$(git rev-parse --show-toplevel 2>/dev/null) || {
  jq -n '{pass: false, rule: null, detail: "not inside a git repository"}'; exit 3; }
cd "$top"
scratch="$(ccm_state_dir)/openspec-scope.$$"
mkdir -p "$scratch"
trap 'rm -rf "$scratch"' EXIT

# result PASS RULE DETAIL [FILE] [LINE] [TASK_ID]: print the verdict and exit.
tasks_json='[]' unchecked_json='[]' done_json='[]' base_sha="" mb_sha=""
result() {
  jq -n --argjson pass "$1" --arg rule "$2" --arg detail "$3" --arg file "${4:-}" \
    --arg line "${5:-}" --arg task "${6:-}" --arg mode "$mode" --arg change "$change" \
    --arg section "$section" --argjson tasks "$tasks_json" --argjson unchecked "$unchecked_json" \
    --argjson tdone "$done_json" --arg base "$base_sha" --arg mb "$mb_sha" '
    {pass: $pass, mode: $mode, change: $change,
     section: ($section | if test("^[0-9]+$") then tonumber else . end),
     rule: (if $rule == "" then null else $rule end),
     detail: (if $detail == "" then null else $detail end),
     file: (if $file == "" then null else $file end),
     line: (if $line == "" then null else ($line | tonumber) end),
     task_id: (if $task == "" then null else $task end),
     tasks: $tasks, unchecked: $unchecked, tasks_done: $tdone}
    + (if $mode == "precheck" then {} else {base: $base, merge_base: $mb} end)'
  [ "$1" = true ] && exit 0
  exit 1
}
fail() { result false "$@"; }
unreadable() { jq -n --arg d "$1" '{pass: false, rule: null, detail: $d}'; exit 3; }

# parse_tasks FILE: a port of Reeve's parseTasks (src/openspec/parse.ts), which
# is stricter than the openspec CLI. Prints "S<TAB>number<TAB>line" per section
# and "T<TAB>line<TAB>section<TAB>id<TAB>checked<TAB>boxbytes" per task
# (checked 1 for x or X, boxbytes the byte length of the box's character), or
# one "E<TAB>rule<TAB>line<TAB>reason" line on the first rejection. It reads
# bytes (LC_ALL=C, the same under gawk, mawk, and BSD awk): the box holds one
# character as JavaScript's "." reads it, so one UTF-8 sequence of up to three
# bytes, and a no-break space (U+00A0) counts as whitespace, as in "\s".
parse_tasks() {
  LC_ALL=C awk '
    # boxlen(s, p): the byte length of the one character at p when s[p + len]
    # is "]", else 0.
    function boxlen(s, p,   b, len, i) {
      b = substr(s, p, 1)
      if (b == "" || b == "\n" || b == "\r") return 0
      if (b < "\200") len = 1
      else if (b >= "\300" && b < "\340") len = 2
      else if (b >= "\340" && b < "\360") len = 3
      else return 0
      for (i = 1; i < len; i++) { c = substr(s, p + i, 1); if (c < "\200" || c >= "\300") return 0 }
      if (len == 3 && (substr(s, p, 3) == LS || substr(s, p, 3) == PS)) return 0
      return substr(s, p + len, 1) == "]" ? len : 0
    }
    function nbsp(s,   k) { while ((k = index(s, NB)) > 0) s = substr(s, 1, k - 1) " " substr(s, k + 2); return s }
    function trim(s) { sub(/^[ \t\r\n\f\v]+/, "", s); sub(/[ \t\r\n\f\v]+$/, "", s); return s }
    function safe(d) { sub(/^0+/, "", d); return length(d) < 16 || (length(d) == 16 && d <= "9007199254740991") }
    function safeparts(id,   n, parts, i) {
      gsub(/[^0-9]+/, " ", id); n = split(id, parts, " ")
      for (i = 1; i <= n; i++) if (!safe(parts[i])) return 0
      return 1
    }
    function reject(rule, line, reason) { printf "E\t%s\t%s\t%s\n", rule, line, reason; bad = 1; exit }
    function closesec() {
      if (cur != "" && ntasks == 0) reject("empty-section", curline, "Section " cur " has no checkbox task.")
      cur = ""
    }
    BEGIN {
      fence = ""; cur = ""; nsec = 0; prev = ""
      NB = sprintf("%c%c", 194, 160); LS = sprintf("%c%c%c", 226, 128, 168); PS = sprintf("%c%c%c", 226, 128, 169)
    }
    {
      raw = $0; sub(/\r$/, "", raw); n = NR
      if (fence == "") {
        if (match(raw, /^ ? ? ?(```+|~~~+)/)) { f = substr(raw, RSTART, RLENGTH); sub(/^ +/, "", f); fence = f; next }
      } else {
        c = substr(fence, 1, 1); t = raw; sub(/^ ? ? ?/, "", t)
        k = 0; while (substr(t, k + 1, 1) == c) k++
        if (k >= length(fence) && substr(t, k + 1) ~ /^[ \t\r\n\f\v]*$/) fence = ""
        next
      }
      if (match(raw, /^ ? ? ?##[ \t]+[0-9]+\./)) {
        head = substr(raw, 1, RLENGTH); rest = substr(raw, RLENGTH + 1)
        if (rest == "" || rest ~ /^[ \t]/) {
          closesec()
          num = head; sub(/^ *##[ \t]+/, "", num); sub(/\.$/, "", num)
          if (!safeparts(num)) reject("number-range", n, "Section number " num " is too large.")
          num = num + 0; title = trim(rest)
          if (title == "") reject("section-title", n, "Section " num " has no title.")
          if (prev != "" && num <= prev) reject("section-order", n, "Section " num " follows section " prev ".")
          cur = num; curline = n; ntasks = 0; prev = num; nsec++
          printf "S\t%s\t%s\n", num, n
          next
        }
      }
      if (raw ~ /^ ? ? ?##/ && substr(raw, index(raw, "##") + 2, 1) != "#") { closesec(); next }
      norm = nbsp(raw)
      if (norm ~ /^[ \t\f\v]*[0-9]+[.)][ \t\f\v]+\[/ && boxlen(raw, index(raw, "[") + 1)) reject("task-marker", n, "A checkbox task uses an ordered list marker.")
      if (norm ~ /^[ \t\f\v]*[-*+][ \t\f\v]+\[/ && (bl = boxlen(raw, (p = index(raw, "[")) + 1))) {
        mark = substr(raw, p + 1, bl); after = nbsp(substr(raw, p + bl + 2))
        if (after == "" || after ~ /^[ \t\r\n\f\v]/) {
          if (cur == "") reject("task-outside-section", n, "A checkbox task is not under a numbered section heading.")
          rest = trim(after)
          if (!match(rest, /^[0-9]+(\.[0-9]+)+[A-Za-z]*/)) reject("unnumbered-task", n, "A checkbox task in section " cur " has no task id.")
          id = substr(rest, 1, RLENGTH); tail = substr(rest, RLENGTH + 1)
          if (tail != "" && tail !~ /^[ \t\r\n\f\v]/) reject("unnumbered-task", n, "A checkbox task in section " cur " has no task id.")
          if (!safeparts(id)) reject("number-range", n, "Task id " id " has a number too large.")
          if (trim(tail) == "") reject("task-text", n, "Task " id " has no text.")
          split(id, ip, "."); if (ip[1] + 0 != cur) reject("task-prefix", n, "Task " id " is under section " cur ".")
          if (id in seen) reject("duplicate-task", n, "Task " id " appears twice.")
          seen[id] = 1; ntasks++
          printf "T\t%s\t%s\t%s\t%s\t%s\n", n, cur, id, (mark == "x" || mark == "X") ? 1 : 0, bl
          next
        }
      }
    }
    END {
      if (bad) exit
      closesec()
      if (!bad && nsec == 0) reject("no-section", "", "The file has no numbered section heading (## 1. Title).")
    }
  ' "$1"
}

# ids_json PARSED SECTION FILTER: task ids of SECTION ("all" for every
# section) from parse_tasks output; FILTER "unchecked" keeps only the open ones.
ids_json() {
  awk -F'\t' -v s="$2" -v f="$3" '$1 == "T" && (s == "all" || $3 == s) && (f != "unchecked" || $5 == 0) { print $4 }' <<<"$1" |
    jq -R . | jq -sc .
}

# parse_error PARSED: set prule, pline, and preason from the "E" line of
# parse_tasks output. The fields are split by hand: tab is IFS whitespace, so
# `IFS=$'\t' read` collapses the empty line field of a no-section rejection
# and shifts the reason into pline. The reason is last and keeps any tab.
parse_error() {
  local l
  l=$(grep -m1 '^E' <<<"$1")
  l=${l#E$'\t'}
  prule=${l%%$'\t'*}; l=${l#*$'\t'}
  pline=${l%%$'\t'*}; preason=${l#*$'\t'}
}

matches_archive() { # FOLDER NAME: Reeve's archiveFolderMatches
  local d='^[0-9]{4}-[0-9]{2}-[0-9]{2}-'
  if [[ $2 =~ $d ]]; then [ "$1" = "$2" ]; else [[ $1 =~ $d ]] && [ "${1:11}" = "$2" ]; fi
}

# ---- precheck ----------------------------------------------------------------

if [ "$mode" = precheck ]; then
  [ "$section" != parent ] || fail section-parent "the parent ticket of $change carries no work; Reeve dispatches only its sections and the archive ticket"
  slug=$(ccm_repo_slug)
  if [ -z "$slug" ]; then
    url=$(git remote get-url origin 2>/dev/null || true)
    url=${url%.git}
    [[ $url =~ ([^/:]+/[^/:]+)$ ]] && slug=${BASH_REMATCH[1]}
  fi
  [ -n "$slug" ] || fail repo-unknown "cannot read this checkout's owner/name (no github_repo config, gh repo view failed, no origin remote)"
  shopt -s nocasematch
  if [[ $slug != "$repo" ]]; then shopt -u nocasematch; fail repo-mismatch "the ticket is for $repo, and this checkout is $slug"; fi
  shopt -u nocasematch
  [ -f "$tasks_path" ] || fail tasks-missing "$tasks_path does not exist in this checkout" "$tasks_path"
  if [ "$section" = archive ] && [ -d openspec/changes/archive ]; then
    for d in openspec/changes/archive/*/; do
      [ -d "$d" ] || continue
      f=${d%/}; f=${f##*/}
      if matches_archive "$f" "$change"; then fail archive-exists "openspec/changes/archive/$f is already the archive of $change" "openspec/changes/archive/$f"; fi
    done
  fi
  parsed=$(parse_tasks "$tasks_path")
  if [[ $parsed == E* || $parsed == *$'\nE'* ]]; then
    parse_error "$parsed"
    fail tasks-unreadable "$tasks_path does not parse ($prule): $preason" "$tasks_path" "$pline"
  fi
  if [ "$section" = archive ]; then
    tasks_json=$(ids_json "$parsed" all all); unchecked_json=$(ids_json "$parsed" all unchecked)
  else
    tasks_json=$(ids_json "$parsed" "$section" all); unchecked_json=$(ids_json "$parsed" "$section" unchecked)
    [ "$tasks_json" != '[]' ] || fail section-missing "$tasks_path has no section $section (## $section.) with a task" "$tasks_path"
  fi
  result true "" ""
fi

# ---- scope: read the two sides ------------------------------------------------

base_sha=$(git rev-parse --verify --quiet "$base^{commit}") || unreadable "cannot resolve base $base to a commit"
head_sha=$(git rev-parse --verify --quiet "HEAD^{commit}") || unreadable "cannot resolve HEAD to a commit"
mb_sha=$(git merge-base "$base_sha" "$head_sha") || unreadable "$base and HEAD have no merge base"
if [ "$worktree" = true ]; then
  idx=$scratch/index
  GIT_INDEX_FILE=$idx git read-tree "$head_sha" || unreadable "cannot read HEAD into a scratch index"
  # Tracked files: every change and deletion, except a path that is now a
  # device, FIFO, or socket (a sandbox's /dev/null mount over a dotfile), which
  # keeps its HEAD content. New files: the untracked ones under openspec/ and
  # the ones staged in the real index, each only a regular file or a symlink.
  { GIT_INDEX_FILE=$idx git ls-files -m -d -z |
      while IFS= read -r -d '' p; do
        if [ -f "$p" ] || [ -L "$p" ] || [ -d "$p" ] || [ ! -e "$p" ]; then printf '%s\0' "$p"; fi
      done &&
    { GIT_INDEX_FILE=$idx git ls-files -o --exclude-standard -z -- openspec/ &&
      git diff --cached --name-only --diff-filter=A --no-renames -z "$head_sha"; } |
      while IFS= read -r -d '' p; do if [ -f "$p" ] || [ -L "$p" ]; then printf '%s\0' "$p"; fi; done
  } | GIT_INDEX_FILE=$idx git update-index --add --remove -z --stdin ||
    unreadable "cannot stage the working tree into a scratch index"
  side=$(GIT_INDEX_FILE=$idx git write-tree) || unreadable "cannot write the working tree as a tree"
else
  side=$head_sha
fi

# The paths the PR touches: STATUS<TAB>OLD<TAB>NEW per entry (OLD empty unless
# renamed or copied), from the merge base, as GitHub lists a PR's files. The
# diff is read NUL-separated: without -z git C-quotes a path holding a double
# quote, a backslash, or a control character ("openspec/x\ty"), even with
# core.quotepath off, and the quoted form escapes every prefix rule below. A
# path holding a tab or a newline cannot be written as one line here, and no
# OpenSpec file has one, so it is reported as unreadable rather than checked.
changes=$scratch/changes
git diff -z --name-status --find-renames "$mb_sha" "$side" >"$scratch/changes.z" ||
  unreadable "cannot list the paths the branch changes from the merge base"
: >"$changes"
while IFS= read -r -d '' st; do
  old=""
  if [[ $st == [RC]* ]]; then
    IFS= read -r -d '' old || unreadable "cannot read git diff -z output"
    st=${st:0:1}
  fi
  IFS= read -r -d '' new || unreadable "cannot read git diff -z output"
  for p in "$old" "$new"; do
    case $p in
      *$'\t'* | *$'\n'*) unreadable "the branch changes $(printf %q "$p"), whose name holds a tab or a newline; no OpenSpec file has one, and this check cannot read it" ;;
    esac
  done
  printf '%s\t%s\t%s\n' "$st" "$old" "$new" >>"$changes"
done <"$scratch/changes.z"
touched() { awk -F'\t' '{ if ($2 != "") print $2; print $3 }' "$changes"; }

# show REV PATH OUT: write REV:PATH to OUT; fails when it does not exist.
show() { git cat-file -e "$1:$2" 2>/dev/null && git cat-file blob "$1:$2" >"$3"; }

# ---- section rules --------------------------------------------------------------

if [ "$mode" = section ]; then
  first=$(touched | awk -v t="$tasks_path" 'index($0, "openspec/") == 1 && $0 != t { print; exit }')
  [ -z "$first" ] || fail outside-section "$first is under openspec/, and a section PR may change only $tasks_path (its own checkboxes)" "$first"

  B=$scratch/base-tasks.md H=$scratch/head-tasks.md
  show "$base_sha" "$tasks_path" "$B" || fail tasks-unreadable "$tasks_path is missing on the base branch ($base)" "$tasks_path"
  show "$side" "$tasks_path" "$H" || fail tasks-unreadable "$tasks_path is missing on the branch" "$tasks_path"
  pb=$(parse_tasks "$B")
  if [[ $pb == E* || $pb == *$'\nE'* ]]; then
    parse_error "$pb"
    fail tasks-unreadable "$tasks_path on the base branch ($base) does not parse ($prule): $preason" "$tasks_path" "$pline"
  fi
  ph=$(parse_tasks "$H")
  if [[ $ph == E* || $ph == *$'\nE'* ]]; then
    parse_error "$ph"
    fail tasks-unreadable "$tasks_path on the branch does not parse ($prule): $preason" "$tasks_path" "$pline"
  fi
  tasks_json=$(ids_json "$pb" "$section" all)
  [ "$tasks_json" != '[]' ] || fail section-missing "section $section is not in $tasks_path on the base branch ($base)" "$tasks_path"
  done_json=$(awk -F'\t' -v s="$section" '
    NR == FNR { if ($1 == "T" && $3 == s && $5 == 0) open[$4] = 1; next }
    $1 == "T" && $3 == s && $5 == 1 && ($4 in open) { print $4 }' <(printf '%s\n' "$pb") <(printf '%s\n' "$ph") |
    jq -R . | jq -sc .)

  # tasks-text: line by line against the base tip. Only a task line of this
  # section may differ, and only in its box, from unchecked to x or X.
  diffline=$(LC_ALL=C awk -F'\t' -v s="$section" '
    FNR == 1 { fileno++ }
    fileno == 1 { if ($1 == "T") { id[$2] = $4; if ($3 == s) { own[$2] = 1; openbox[$2] = ($5 == 0); boxbytes[$2] = $6 } } next }
    fileno == 2 { b[FNR] = $0; nb = FNR; next }
    { h[FNR] = $0; nh = FNR }
    END {
      m = nb > nh ? nb : nh
      for (i = 1; i <= m; i++) {
        if ((i in b) && (i in h) && b[i] == h[i]) continue
        if ((i in own) && openbox[i] && (i in b) && (i in h)) {
          # The box is the first "[" on a task line: only the list marker and
          # whitespace come before it.
          p = index(b[i], "[")
          pre = substr(b[i], 1, p); post = substr(b[i], p + boxbytes[i] + 1)
          if (h[i] == pre "x" post || h[i] == pre "X" post) continue
        }
        printf "%s\t%s\n", i, ((i in id) ? id[i] : ""); exit
      }
    }' <(printf '%s\n' "$pb") "$B" "$H")
  if [ -z "$diffline" ]; then
    # Same lines; the files can still differ in a final newline.
    [ "$(tail -c1 "$B" | od -An -c | tr -d ' ')" = "$(tail -c1 "$H" | od -An -c | tr -d ' ')" ] ||
      diffline="$(($(wc -l <"$B") + 1))	"
  fi
  if [ -n "$diffline" ]; then
    IFS=$'\t' read -r dl did <<<"$diffline"
    fail tasks-text "$tasks_path line $dl${did:+ (task $did)} differs from the base branch ($base); a section PR may change only its own tasks' checkboxes, from unchecked to x" "$tasks_path" "$dl" "$did"
  fi

  unchecked_json=$(ids_json "$ph" "$section" unchecked)
  if [ "$unchecked_json" != '[]' ]; then
    fail tasks-unchecked "section $section has unchecked tasks: $(jq -r 'join(", ")' <<<"$unchecked_json")" "$tasks_path" "" "$(jq -r '.[0]' <<<"$unchecked_json")"
  fi
  result true "" ""
fi

# ---- archive rules --------------------------------------------------------------

# files REV PREFIX: "relative-path<TAB>blob" for every file under PREFIX/.
files() { git ls-tree -r --full-tree "$1" -- "$2/" | awk -F'\t' -v p="$2/" '{ split($1, m, " "); print substr($2, length(p) + 1) "\t" m[3] }' | LC_ALL=C sort; }
folders() { git ls-tree -d --name-only --full-tree "$1" -- openspec/changes/archive/ | sed 's|^openspec/changes/archive/||' | LC_ALL=C sort; }

base_files=$(files "$base_sha" "$dir")
[ -n "$base_files" ] || fail not-moved "$dir is not on the base branch ($base)" "$dir"
[ -z "$(files "$side" "$dir")" ] || fail not-moved "$dir is still on the branch; openspec archive moves it" "$dir"
new=$(LC_ALL=C comm -13 <(folders "$base_sha") <(folders "$side"))
count=$(grep -c . <<<"$new" || true)
[ "$count" -eq 1 ] || fail not-moved "the branch adds $count archive folders ($(tr '\n' ' ' <<<"$new" | sed 's/ $//')); openspec archive adds exactly one" "openspec/changes/archive"
F=$new
matches_archive "$F" "$change" || fail not-moved "openspec/changes/archive/$F is not an archive name for $change (YYYY-MM-DD-$change, or the name itself when it starts with a date)" "openspec/changes/archive/$F"
adir="openspec/changes/archive/$F"

head_files=$(files "$side" "$adir")
if [ "$base_files" != "$head_files" ]; then
  f=$({ diff <(printf '%s\n' "$base_files") <(printf '%s\n' "$head_files") || true; } | awk -F'\t' '/^[<>] / { print substr($1, 3); exit }')
  fail folder-content "$adir/$f differs from $dir/$f on the base branch ($base), is missing, or was added; the archive must hold exactly the change's files" "$adir/$f"
fi

A=$scratch/archived-tasks.md
if show "$side" "$adir/tasks.md" "$A"; then
  pa=$(parse_tasks "$A")
  if [[ $pa == E* || $pa == *$'\nE'* ]]; then
    parse_error "$pa"
    fail tasks-unreadable "$adir/tasks.md does not parse ($prule): $preason" "$adir/tasks.md" "$pline"
  fi
  tasks_json=$(ids_json "$pa" all all); unchecked_json=$(ids_json "$pa" all unchecked)
  [ "$unchecked_json" = '[]' ] ||
    fail tasks-unchecked "the archived change has unchecked tasks: $(jq -r 'join(", ")' <<<"$unchecked_json")" "$adir/tasks.md" "" "$(jq -r '.[0]' <<<"$unchecked_json")"
else
  fail tasks-unreadable "$adir/tasks.md is missing" "$adir/tasks.md"
fi

caps=" $(awk -F'\t' '$1 ~ /^specs\/[^\/]+\// { split($1, p, "/"); print p[2] }' <<<"$base_files" | sort -u | tr '\n' ' ')"
first=$(touched | awk -v d="$dir/" -v a="$adir/" -v caps="$caps" '
  index($0, d) == 1 || index($0, a) == 1 { next }
  $0 ~ /^openspec\/specs\/[^\/]+\/spec\.md$/ { split($0, p, "/"); if (index(caps, " " p[3] " ")) next }
  { print; exit }')
[ -z "$first" ] || fail outside-archive "$first is outside what openspec archive writes for $change (the change folder's move and openspec/specs/<cap>/spec.md for the capabilities its specs/ folder names)" "$first"

meta=$scratch/meta.yaml
flag() { show "$base_sha" "$dir/.openspec.yaml" "$meta" && grep -qE "^$1:[[:space:]]*(true|True|TRUE)[[:space:]]*(#.*)?$" "$meta"; }
skip=false retire=false
flag skip_specs && skip=true
flag retire_capabilities && retire=true
specs=$(awk -F'\t' '($2 ~ /^openspec\/specs\//) || ($3 ~ /^openspec\/specs\//)' "$changes")
if [ "$skip" = true ]; then
  [ -z "$specs" ] || fail specs-changed "$dir/.openspec.yaml sets skip_specs: true, and the branch changes $(head -1 <<<"$specs" | cut -f3)" "$(head -1 <<<"$specs" | cut -f3)"
else
  wrote=$(awk -F'\t' -v r="$retire" '($1 ~ /^[AMR]/ && $3 ~ /^openspec\/specs\//) || (r == "true" && $1 == "D")' <<<"$specs")
  [ -n "$wrote" ] || fail specs-unchanged "no openspec/specs/<cap>/spec.md is added or modified, and $dir/.openspec.yaml does not set skip_specs: true" "openspec/specs"
fi
gone=$(awk -F'\t' '$1 == "D" && $3 ~ /^openspec\/specs\// { print $3 } $1 == "R" && $2 ~ /^openspec\/specs\// { print $2 }' <<<"$specs" | sed -n 1p)
if [ -n "$gone" ]; then
  [ "$retire" = true ] || fail spec-deleted "$gone is removed, and $dir/.openspec.yaml does not set retire_capabilities: true" "$gone"
  cap=${gone#openspec/specs/}; cap=${cap%%/*}
  [[ $caps == *" $cap "* ]] || fail spec-deleted "$gone is removed, and $change does not name capability $cap" "$gone"
fi
result true "" ""
