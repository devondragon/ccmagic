#!/usr/bin/env bash
# ccm-harness: bring up a repository's UI harness for one ticket in Docker,
# run commands in it, and copy screenshots out, printing JSON. It judges
# nothing.
#
# Usage: ccm-harness check [TICKET]
#        ccm-harness up TICKET
#        ccm-harness down TICKET
#        ccm-harness sweep [HOURS]
#
# The harness is .ccmagic/harness.compose.yml, a Compose file whose top-level
# x-ccm-harness key declares how ccmagic uses it (docs/harness.md). The file
# is committed, and every value in it is literal.
#
# Docker and Compose always run with an emptied environment: only PATH, HOME,
# DOCKER_HOST, DOCKER_CONFIG, and TMPDIR pass through, and Compose reads no
# .env file. A session's GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, and tracker
# secrets therefore cannot reach a container by interpolation or by a bare
# `environment: [KEY]`. These rules catch mistakes; they are not a security
# boundary, since a session can drive the Docker API directly.
#
# check: validates the file and prints {status: ok, file, project, declaration}
# (exit 0), {status: absent, file} (exit 2), or {status: invalid, rule,
# detail} (exit 1). project is ccm-<TICKET lowercased> when TICKET is given.
#
# up: first sweeps stacks older than 6 hours and removes this ticket's earlier
# stack, so a rerun never reuses old volumes. Then it builds and starts the
# stack, starts the runner container on the stack's network, and waits for
# the app's health URL as the runner sees it. Prints {status: up, project,
# runner, app_url, published_url, duration_s} (exit 0), or {status:
# build-failed, tail}, {status: unhealthy, timeout_seconds, logs}, or the
# check's invalid or absent object (exit 1 or 2). published_url is null
# unless CCM_HARNESS_PUBLISH=1, which publishes the app on 127.0.0.1 only.
# health_timeout_seconds (default 600) measures app health only: its clock
# starts when the runner is up, after the build. Each probe times out after 5
# seconds.
# The up log is <state dir>/harness/<project>/up.log.
#
# down: removes the ticket's runner and stack. Prints {status: down, project}.
#
# sweep [HOURS]: removes every ccm-* stack whose newest container is at least
# HOURS old (default 6). Prints {status: swept, removed: [project, ...]}.
#
# Exit codes: 0 ok, 1 failed or invalid, 2 no harness, 3 not a git
# repository, 4 usage error.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=bin/ccm-lib.sh
. "$here/ccm-lib.sh"

HARNESS_REL=.ccmagic/harness.compose.yml

usage() {
  echo "usage: ccm-harness check [TICKET] | up TICKET | down TICKET | sweep [HOURS]" >&2
  exit 4
}

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  jq -n '{status: "error", error: "not a git repository"}'
  exit 3
}
HARNESS=$ROOT/$HARNESS_REL
TMPERR=$(mktemp "${TMPDIR:-/tmp}/ccm-harness.XXXXXX")
trap 'rm -f "$TMPERR"' EXIT
PROJECT=
OVERRIDE=

# ccm-<ticket>, lowercased, every character Compose refuses replaced by '-'.
project_for() {
  printf 'ccm-%s' "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')"
}

clean_env() {
  local v args=()
  for v in PATH HOME DOCKER_HOST DOCKER_CONFIG TMPDIR; do
    [ -n "${!v:-}" ] && args+=("$v=${!v}")
  done
  env -i ${args[@]+"${args[@]}"} "$@"
}

dk() { clean_env docker "$@"; }

dc() {
  local files=(-f "$HARNESS")
  [ -n "$OVERRIDE" ] && files+=(-f "$OVERRIDE")
  clean_env docker compose --env-file /dev/null "${files[@]}" -p "${PROJECT:-ccm-check}" "$@"
}

invalid() {
  jq -n --arg r "$1" --arg d "$2" '{status: "invalid", rule: $r, detail: $d}'
  exit 1
}

cmd_check() {
  local ticket=${1:-} line raw cfg broken decl workdir image lock locked tag
  [ -f "$HARNESS" ] || {
    jq -n --arg f "$HARNESS_REL" '{status: "absent", file: $f}'
    exit 2
  }
  # Read the merged model before Compose interpolates it, so included and
  # extended files are covered, YAML escapes are decoded, and comments are
  # gone. $$ is Compose's escape for a literal $ and stays $$ here.
  raw=$(dc config --no-interpolate --no-env-resolution --format json 2>"$TMPERR") ||
    invalid compose "docker compose config failed: $(head -1 "$TMPERR")"
  line=$(jq -r '
    [ paths(type == "string") as $p | select((getpath($p) | gsub("\\$\\$"; "") | test("\\$(\\{|[A-Za-z_])")))
      | ($p | map(tostring) | join(".")) ] | .[0] // empty' <<<"$raw") ||
    invalid compose "could not read the Compose model"
  [ -z "$line" ] || invalid interpolation "$line interpolates a variable; write every value literally"
  cfg=$(dc config --format json --no-env-resolution 2>"$TMPERR") ||
    invalid compose "docker compose config failed: $(head -1 "$TMPERR")"
  broken=$(jq -r --arg nb "${CCM_HARNESS_NO_BIND_MOUNTS:-}" '
    def svc: .services | to_entries[];
    [ (svc | select(.value.env_file) | "env-file\tservice \(.key) names an env_file; write values in environment instead"),
      (svc | . as $s | (.value.environment // {}) | to_entries[] | select(.value == null)
        | "environment-passthrough\tservice \($s.key) takes \(.key) from the caller'"'"'s environment; give it a literal value"),
      (svc | . as $s | ("privileged", "cap_add", "devices", "restart") as $k
        | select(($s.value[$k] // false) != false and ($s.value[$k] // []) != [])
        | "forbidden-key\tservice \($s.key) sets \($k)"),
      (svc | select(.value.network_mode == "host") | "forbidden-key\tservice \(.key) sets network_mode: host"),
      (svc | select(.value.pid == "host") | "forbidden-key\tservice \(.key) sets pid: host"),
      (svc | select((.value.ports // []) | length > 0)
        | "published-port\tservice \(.key) publishes a port; the runner reaches services on the stack network"),
      (svc | . as $s | (.value.volumes // [])[] | select($nb == "1" and .type == "bind")
        | "bind-mount\tservice \($s.key) bind-mounts \(.source); the daemon cannot see this checkout, so build the files into the image"),
      (if (.["x-ccm-harness"] | type) != "object" then "declaration\tthe file has no top-level x-ccm-harness mapping" else empty end)
    ] | .[0] // empty' <<<"$cfg") ||
    invalid compose "could not evaluate the Compose model"
  [ -z "$broken" ] || invalid "${broken%%$'\t'*}" "${broken#*$'\t'}"
  decl=$(jq -c '.["x-ccm-harness"]' <<<"$cfg")
  broken=$(jq -r --argjson svcs "$(jq -c '.services | keys' <<<"$cfg")" '
    if (.app | type) != "object" then "app must be a mapping"
    elif (.runner | type) != "object" then "runner must be a mapping"
    elif .seed != null and (.seed | type) != "object" then "seed must be a mapping"
    elif .env != null and (.env | type) != "object" then "env must be a mapping"
    else
    [ (if .version != 1 then "version must be 1" else empty end),
      (if (.app.service | type) != "string" or ([.app.service] | inside($svcs) | not) then "app.service must name a service in the file" else empty end),
      (if (.app.port | type) != "number" then "app.port must be a number" else empty end),
      (if (.app.health | type) != "string" or (.app.health | startswith("/") | not) then "app.health must be a path starting with /" else empty end),
      (if (.runner.image | type) != "string" then "runner.image is required" else empty end),
      (if (.runner.workdir | type) != "string" then "runner.workdir is required" else empty end),
      (if .evidence != null and ([.evidence] | inside(["auto", "push", "off"]) | not) then "evidence must be auto, push, or off" else empty end)
    ] | .[0] // empty
    end' <<<"$decl") ||
    invalid declaration "x-ccm-harness could not be read"
  [ -z "$broken" ] || invalid declaration "x-ccm-harness: $broken"
  workdir=$(jq -r '.runner.workdir' <<<"$decl")
  image=$(jq -r '.runner.image' <<<"$decl")
  if [ -f "$ROOT/$workdir/package.json" ] &&
    jq -e '((.dependencies // {}) + (.devDependencies // {}))["@playwright/test"]' "$ROOT/$workdir/package.json" >/dev/null; then
    lock=$workdir/package-lock.json
    git -C "$ROOT" ls-files --error-unmatch "$lock" >/dev/null 2>&1 ||
      invalid playwright-lockfile "$workdir/package.json uses @playwright/test, and $lock is not committed; the runner image must match the locked version"
    locked=$(jq -r '.packages["node_modules/@playwright/test"].version // empty' "$ROOT/$lock")
    tag=$(sed -nE 's#^mcr\.microsoft\.com/playwright:v([0-9]+\.[0-9]+\.[0-9]+).*#\1#p' <<<"$image")
    [ -n "$locked" ] && [ "$tag" = "$locked" ] ||
      invalid playwright-version "runner image $image does not match @playwright/test ${locked:-(not in the lockfile)} in $lock; its browsers work only with their own version"
  fi
  jq -n --arg f "$HARNESS_REL" --arg p "${ticket:+$(project_for "$ticket")}" --argjson d "$decl" \
    '{status: "ok", file: $f, project: (if $p == "" then null else $p end), declaration: $d}'
}

# Set DECL and its fields from a passing check, or print the check's result
# and exit with its code.
load_decl() {
  local out rc
  out=$(cmd_check) && rc=0 || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$out"
    exit "$rc"
  fi
  DECL=$(jq -c '.declaration' <<<"$out")
  SERVICE=$(jq -r '.app.service' <<<"$DECL")
  PORT=$(jq -r '.app.port' <<<"$DECL")
  HEALTH=$(jq -r '.app.health' <<<"$DECL")
  TIMEOUT=$(jq -r '.app.health_timeout_seconds // 600' <<<"$DECL")
  IMAGE=$(jq -r '.runner.image' <<<"$DECL")
  # shellcheck disable=SC2034  # used by the commands added after up
  WORKDIR=$(jq -r '.runner.workdir' <<<"$DECL")
}

state_dir() {
  STATE=$(ccm_state_dir)/harness/$PROJECT
  mkdir -p "$STATE"
}

# Remove everything labeled with project P: containers (the runner carries
# ccm.project), networks, volumes, and images. Needs no compose file.
remove_project() {
  local p=$1 f ids
  for f in "label=ccm.project=$p" "label=com.docker.compose.project=$p"; do
    ids=$(dk ps -aq --filter "$f")
    # shellcheck disable=SC2086
    [ -z "$ids" ] || dk rm -f $ids >/dev/null 2>&1
  done
  ids=$(dk network ls -q --filter "label=com.docker.compose.project=$p")
  # shellcheck disable=SC2086
  [ -z "$ids" ] || dk network rm $ids >/dev/null 2>&1
  ids=$(dk volume ls -q --filter "label=com.docker.compose.project=$p")
  # shellcheck disable=SC2086
  [ -z "$ids" ] || dk volume rm -f $ids >/dev/null 2>&1
  ids=$(dk image ls -q --filter "label=com.docker.compose.project=$p")
  # shellcheck disable=SC2086
  [ -z "$ids" ] || dk image rm -f $ids >/dev/null 2>&1
  return 0
}

cmd_down_quiet() {
  dk rm -f "$RUNNER" >/dev/null 2>&1
  # compose down needs a usable file; remove_project below needs none.
  if [ -f "$HARNESS" ] && (cmd_check >/dev/null 2>&1); then
    dc down -v --rmi local --remove-orphans >/dev/null 2>&1
  fi
  remove_project "$PROJECT"
}

cmd_down() {
  cmd_down_quiet
  jq -n --arg p "$PROJECT" '{status: "down", project: $p}'
}

# Each ccm-* project with the creation time of its newest container.
projects_with_age() {
  local ids
  ids=$({ dk ps -aq --filter label=ccm.project; dk ps -aq --filter label=com.docker.compose.project; } | sort -u)
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086
  dk inspect $ids | jq -r '.[]
    | [(.Config.Labels["ccm.project"] // .Config.Labels["com.docker.compose.project"]),
       (.Created | sub("\\.[0-9]+"; "") | fromdateiso8601)] | @tsv' |
    sort -t "$(printf '\t')" -k1,1 -k2,2nr | awk -F '\t' '!seen[$1]++'
}

cmd_sweep() {
  local hours=${1:-6} cutoff p created removed=()
  case $hours in '' | *[!0-9]*) usage ;; esac
  cutoff=$(($(date +%s) - hours * 3600))
  while IFS="$(printf '\t')" read -r p created; do
    case $p in ccm-*) ;; *) continue ;; esac
    [ "$created" -le "$cutoff" ] || continue
    remove_project "$p"
    removed+=("$p")
  done < <(projects_with_age)
  jq -n '{status: "swept", removed: $ARGS.positional}' --args ${removed[@]+"${removed[@]}"}
}

runner_get() {
  dk exec "$RUNNER" node -e \
    'fetch(process.argv[1], { signal: AbortSignal.timeout(5000) }).then(r => process.exit(r.status === 200 ? 0 : 1), () => process.exit(1))' "$1" \
    >/dev/null 2>&1
}

start_runner() {
  local cid net kv env=()
  cid=$(dc ps -q "$SERVICE" 2>/dev/null | head -1)
  [ -n "$cid" ] || return 1
  net=$(dk inspect "$cid" | jq -r '.[0].NetworkSettings.Networks | keys[0]')
  while IFS= read -r kv; do
    [ -n "$kv" ] && env+=(-e "$kv")
  done < <(jq -r '.env // {} | to_entries[] | "\(.key)=\(.value)"' <<<"$DECL")
  dk run -d --name "$RUNNER" --label "ccm.project=$PROJECT" --network "$net" -w /work \
    -e "APP_BASE_URL=$APP_URL" -e OUT_DIR=/out ${env[@]+"${env[@]}"} \
    --entrypoint sleep "$IMAGE" infinity >/dev/null
}

# Bring the stack up from nothing and wait for the app's health URL, as seen
# from the runner on the stack's network. Prints the result JSON.
do_up() {
  local started hstart log published=
  started=$(date +%s)
  log=$STATE/up.log
  : >"$log"
  cmd_sweep 6 >/dev/null
  cmd_down_quiet
  if [ "${CCM_HARNESS_PUBLISH:-}" = 1 ]; then
    OVERRIDE=$STATE/publish.yml
    printf 'services:\n  %s:\n    ports: ["127.0.0.1::%s"]\n' "$SERVICE" "$PORT" >"$OVERRIDE"
  fi
  if ! dc up -d --build >>"$log" 2>&1; then
    jq -n --arg t "$(tail -40 "$log")" '{status: "build-failed", tail: $t}'
    return 1
  fi
  if ! start_runner >>"$log" 2>&1; then
    jq -n --arg t "$(tail -40 "$log")" '{status: "runner-failed", tail: $t}'
    return 1
  fi
  hstart=$(date +%s)
  until runner_get "http://$SERVICE:$PORT$HEALTH"; do
    if [ $(($(date +%s) - hstart)) -ge "$TIMEOUT" ]; then
      dc logs --no-color --tail 200 >>"$log" 2>&1
      jq -n --arg t "$(tail -200 "$log")" --argjson s "$TIMEOUT" '{status: "unhealthy", timeout_seconds: $s, logs: $t}'
      return 1
    fi
    sleep 5
  done
  [ -n "$OVERRIDE" ] && published="http://$(dc port "$SERVICE" "$PORT" | head -1)"
  jq -n --arg p "$PROJECT" --arg r "$RUNNER" --arg u "$APP_URL" --arg pub "$published" \
    --argjson d $(($(date +%s) - started)) \
    '{status: "up", project: $p, runner: $r, app_url: $u, published_url: (if $pub == "" then null else $pub end), duration_s: $d}'
}

# PROJECT, RUNNER, and STATE for a ticket, without reading the harness file.
ticket_names() {
  [ -n "${1:-}" ] || usage
  PROJECT=$(project_for "$1")
  RUNNER=$PROJECT-runner
  state_dir
}

ticket_setup() {
  [ -n "${1:-}" ] || usage
  load_decl
  ticket_names "$1"
  APP_URL=http://$SERVICE:$PORT
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  check) [ $# -le 1 ] || usage; cmd_check "$@" ;;
  up)
    ticket_setup "${1:-}"
    out=$(do_up) && rc=0 || rc=$?
    printf '%s\n' "$out"
    exit "$rc"
    ;;
  down) [ $# -eq 1 ] || usage; ticket_names "$1"; cmd_down ;;
  sweep) [ $# -le 1 ] || usage; cmd_sweep "${1:-6}" ;;
  *) usage ;;
esac
