#!/usr/bin/env bash
# ccm-review-route: decide QUICK or DEEP for /ccmagic:review, as JSON.
#
# Usage:
#   ccm-review-route [RANGE | PR]           route a git diff range or a PR
#   ccm-review-route --diff-file FILE|-     route a unified diff (- is stdin)
#   ccm-review-route --record NAME=N[,NAME=N...]
#                                           add one review's specialist counts
#
# RANGE is anything `git diff` accepts. With no argument the range is
# main...HEAD, the branch diff /ccmagic:review uses today. A bare integer (or
# #N) is a PR number, read with `gh pr diff N`. --diff-file is for a diff that
# was pasted rather than checked out.
#
# The route is QUICK only when all of these hold, otherwise DEEP:
#   - at most 2 files changed
#   - at most 50 changed lines (additions + deletions)
#   - no changed path (old or new name) contains a risk pattern, compared
#     case-insensitively against the full path
#   - no added line declares a type: class, interface, type, struct, enum, or
#     trait followed by a space
#   - no added or removed line touches error flow: try, catch, except, rescue,
#     finally, panic, recover (whole words), Result<, or Either
#
# Output: {route, reason, line, source, files, lines, additions, deletions,
# file_list, risk_matches: [{path, patterns}], new_types: [{path, text}],
# error_flow: [{path, text}], failed, stats_file, gated, stats_error?}.
# `line` is the routing line the skill prints. `failed` names the conditions
# that forced DEEP (files, lines, risk_path, new_types, error_flow).
#
# Review stats live in context/review-stats.json at the repo root (the current
# directory outside a repo), as {"<specialist>": {"dispatched": N,
# "findings": N}}. `gated` lists specialists with 0 findings across 10 or more
# dispatches; security is never gated. --record adds 1 to `dispatched` and N
# to `findings` for each NAME=N and prints {stats_file, stats, gated}.
#
# Exit codes:
#   0  route decided, or stats recorded
#   3  couldn't read the diff (bad range, not a git repository, gh failed,
#      missing file) or, with --record, the existing stats file
#   4  usage error

set -euo pipefail
# shellcheck source=bin/ccm-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/ccm-lib.sh"

RISK_PATTERNS='auth login session token secret credential password key oauth
crypto hash sign jwt permission role acl authz
migration schema sql query exec eval
payment billing charge refund stripe
security sanitiz escap csrf xss injection
deploy infra terraform helm dockerfile ci/ .github/workflows'
MAX_FILES=2
MAX_LINES=50
GATE_MIN_DISPATCHES=10

usage() { echo "ccm-review-route: $1" >&2; exit 4; }

target="" diff_file="" record="" have_target=false
while [ $# -gt 0 ]; do
  case $1 in
    --diff-file) [ -n "${2:-}" ] || usage "--diff-file needs a file or -"; diff_file=$2; shift ;;
    --record) [ -n "${2:-}" ] || usage "--record needs NAME=N[,NAME=N...]"; record=$2; shift ;;
    -h|--help) sed -n '2,41p' "$0"; exit 0 ;;
    -) usage "use --diff-file - to read a diff from stdin" ;;
    -*) usage "unknown flag $1" ;;
    *) $have_target && usage "more than one range or PR given"; target=$1; have_target=true ;;
  esac
  shift
done

if [ -n "$record" ] && { $have_target || [ -n "$diff_file" ]; }; then
  usage "--record takes no range, PR, or --diff-file"
fi
if $have_target && [ -n "$diff_file" ]; then
  usage "give a range or PR, or --diff-file, not both"
fi

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
stats_file=$root/context/review-stats.json

# gated STATS_JSON: specialists to skip, as a JSON array of {specialist, dispatched}.
gated() {
  jq -c --argjson min "$GATE_MIN_DISPATCHES" '
    [to_entries[]
     | select(.key != "security" and (.value | type) == "object")
     | select((.value.dispatched // 0) >= $min and (.value.findings // 0) == 0)
     | {specialist: .key, dispatched: .value.dispatched}]' <<<"$1"
}

# ---- --record ----------------------------------------------------------------

if [ -n "$record" ]; then
  add='{}'
  IFS=',' read -r -a pairs <<<"$record"
  for pair in "${pairs[@]}"; do
    name=${pair%%=*} n=${pair#*=}
    [ "$pair" != "$name" ] || usage "--record entry '$pair' is not NAME=N"
    [[ $name =~ ^[a-z][a-z0-9_-]*$ ]] || usage "--record specialist name '$name' must be lowercase letters, digits, - or _"
    [[ $n =~ ^[0-9]+$ ]] || usage "--record findings for '$name' must be a whole number, got '$n'"
    add=$(jq -c --arg k "$name" --argjson n "$n" '.[$k] = $n' <<<"$add")
  done

  stats='{}'
  if [ -f "$stats_file" ]; then
    if ! stats=$(jq -c 'if type == "object" then . else error("not an object") end' "$stats_file" 2>/dev/null); then
      jq -n --arg f "$stats_file" '{error: "stats file is not a JSON object; left unchanged", stats_file: $f}'
      exit 3
    fi
  fi
  stats=$(jq -c --argjson add "$add" '
    reduce ($add | to_entries[]) as $e (.;
      .[$e.key] = ((.[$e.key] // {}) | if type == "object" then . else {} end)
      | .[$e.key].dispatched = ((.[$e.key].dispatched // 0) + 1)
      | .[$e.key].findings = ((.[$e.key].findings // 0) + $e.value))' <<<"$stats")
  mkdir -p "$(dirname "$stats_file")"
  tmp=$(mktemp "$stats_file.XXXXXX")
  jq . <<<"$stats" >"$tmp"
  mv -f "$tmp" "$stats_file"
  jq -n --arg f "$stats_file" --argjson s "$stats" --argjson g "$(gated "$stats")" \
    '{stats_file: $f, stats: $s, gated: $g}'
  exit 0
fi

# ---- read the diff -----------------------------------------------------------

fail_read() {
  jq -n --arg e "$1" --arg d "$2" '{error: $e, detail: $d}'
  exit 3
}

err=$(mktemp)
trap 'rm -f "$err"' EXIT

if [ -n "$diff_file" ]; then
  source_kind=file source_value=$diff_file
  if [ "$diff_file" = - ]; then
    diff=$(cat)
  elif [ -f "$diff_file" ]; then
    diff=$(cat "$diff_file")
  else
    fail_read "diff file not found" "$diff_file"
  fi
elif [[ $target =~ ^#?[0-9]+$ ]]; then
  source_kind=pr source_value=${target#\#}
  diff=$(gh pr diff "$source_value" 2>"$err") || fail_read "gh pr diff $source_value failed" "$(cat "$err")"
else
  source_kind=range source_value=${target:-main...HEAD}
  git rev-parse --git-dir >/dev/null 2>&1 || fail_read "not a git repository" "$PWD"
  diff=$(git diff --no-color --no-ext-diff "$source_value" -- 2>"$err") ||
    fail_read "git diff $source_value failed" "$(cat "$err")"
fi

# ---- parse -----------------------------------------------------------------
#
# Emits one record per line: "F<TAB>path<TAB>oldpath" starts a file, then
# "+<TAB>text" and "-<TAB>text" for its added and removed lines. A hunk's
# line counts decide where it ends, so a removed line that starts with "--"
# is not mistaken for a file header. A ---/+++ pair outside a hunk starts a
# file too, for diffs pasted without "diff --git" lines.

parsed=$(printf '%s\n' "$diff" | awk '
  { sub(/\r$/, ""); L[++n] = $0 }
  function strip(p) {
    sub(/\t.*$/, "", p)
    if (p == "/dev/null") return ""
    sub(/^[ab]\//, "", p)
    return p
  }
  function flush() {
    if (have) printf "F\t%s\t%s\n", (newp != "" ? newp : oldp), (oldp != "" ? oldp : newp)
    for (j = 1; j <= nb; j++) print B[j]
    have = 0; nb = 0; newp = ""; oldp = ""
  }
  function hunk_counts(s,   a, b) {
    # @@ -a[,b] +c[,d] @@
    split(s, a, " ")
    b = a[2]; sub(/^-/, "", b); orem = (b ~ /,/) ? substr(b, index(b, ",") + 1) + 0 : 1
    b = a[3]; sub(/^\+/, "", b); nrem = (b ~ /,/) ? substr(b, index(b, ",") + 1) + 0 : 1
  }
  END {
    orem = 0; nrem = 0; inh = 0
    for (i = 1; i <= n; i++) {
      s = L[i]
      if (s ~ /^diff --git /) {
        flush(); have = 1; inh = 0
        p = substr(s, 12); q = p
        sub(/ b\/.*$/, "", p); sub(/^a\//, "", p)
        sub(/^.* b\//, "", q)
        oldp = p; newp = q
        continue
      }
      if (s ~ /^@@ /) { inh = 1; hunk_counts(s); continue }
      if (inh && (orem > 0 || nrem > 0)) {
        c = substr(s, 1, 1)
        if (c == "+") { B[++nb] = "+\t" substr(s, 2); nrem--; continue }
        if (c == "-") { B[++nb] = "-\t" substr(s, 2); orem--; continue }
        if (c == " " || s == "") { orem--; nrem--; continue }
        if (c == "\\") continue
      }
      if (inh && (orem <= 0 && nrem <= 0)) {
        c = substr(s, 1, 1)
        # Hand-written diffs undercount; keep taking +/- lines until a header.
        if (c == "+" && s !~ /^\+\+\+ /) { B[++nb] = "+\t" substr(s, 2); continue }
        if (c == "-" && !(s ~ /^--- / && L[i + 1] ~ /^\+\+\+ /)) { B[++nb] = "-\t" substr(s, 2); continue }
        if (c == "\\") continue
      }
      if (s ~ /^--- / && L[i + 1] ~ /^\+\+\+ /) {
        if (!have || inh) { flush(); have = 1 }
        inh = 0
        o = strip(substr(s, 5)); w = strip(substr(L[i + 1], 5))
        if (o != "") oldp = o
        if (w != "") newp = w
        i++
        continue
      }
      if (have && s ~ /^rename from /) { oldp = substr(s, 13); continue }
      if (have && s ~ /^rename to /) { newp = substr(s, 11); continue }
    }
    flush()
  }')

# ---- decide ------------------------------------------------------------------

stats='{}' stats_error=""
if [ -f "$stats_file" ]; then
  stats=$(jq -c 'if type == "object" then . else error("not an object") end' "$stats_file" 2>/dev/null) || {
    stats='{}' stats_error="context/review-stats.json is not a JSON object; nothing gated"
  }
fi

printf '%s\n' "$parsed" | jq -R -s \
  --arg risk "$RISK_PATTERNS" \
  --argjson max_files "$MAX_FILES" --argjson max_lines "$MAX_LINES" \
  --arg kind "$source_kind" --arg value "$source_value" \
  --arg stats_file "$stats_file" --argjson gated "$(gated "$stats")" --arg stats_error "$stats_error" '
  def trunc: if length > 120 then .[0:117] + "..." else . end;
  def plural($n; $w): "\($n) \($w)\(if $n == 1 then "" else "s" end)";
  ($risk | split("\\s+"; null) | map(select(. != ""))) as $patterns
  | (split("\n") | map(select(. != ""))
     | reduce .[] as $l ({files: [], cur: null};
         ($l | split("\t")) as $f
         | if $f[0] == "F" then
             .files += [{path: $f[1], old: $f[2], adds: [], dels: []}]
           elif ($f[0] == "+" or $f[0] == "-") and (.files | length) > 0 then
             ($l[2:]) as $text
             | (.files | length - 1) as $i
             | if $f[0] == "+" then .files[$i].adds += [$text] else .files[$i].dels += [$text] end
           else . end)
     | .files) as $files
  | ([$files[].adds | length] | add // 0) as $adds
  | ([$files[].dels | length] | add // 0) as $dels
  | ($adds + $dels) as $lines
  | [ $files[]
      | .path as $p
      | ([.path, .old] | unique | map(ascii_downcase)) as $names
      | [ $patterns[] as $pat | select(any($names[]; contains($pat | ascii_downcase))) | $pat ] as $hit
      | select($hit | length > 0)
      | {path: $p, patterns: $hit} ] as $risk_matches
  | [ $files[] | .path as $p | .adds[]
      | select(test("(^|[^A-Za-z0-9_])(class|interface|type|struct|enum|trait) "))
      | {path: $p, text: (gsub("^\\s+"; "") | trunc)} ] as $new_types
  | [ $files[] | .path as $p | (.adds[], .dels[])
      | select(test("(^|[^A-Za-z0-9_])(try|catch|except|rescue|finally|panic|recover)([^A-Za-z0-9_]|$)|Result<|(^|[^A-Za-z0-9_])Either([^A-Za-z0-9_]|$)"))
      | {path: $p, text: (gsub("^\\s+"; "") | trunc)} ] as $error_flow
  | ($files | length) as $nfiles
  | [ (if $nfiles > $max_files then "files" else empty end),
      (if $lines > $max_lines then "lines" else empty end),
      (if ($risk_matches | length) > 0 then "risk_path" else empty end),
      (if ($new_types | length) > 0 then "new_types" else empty end),
      (if ($error_flow | length) > 0 then "error_flow" else empty end) ] as $failed
  | (if ($failed | length) == 0 then "QUICK" else "DEEP" end) as $route
  | ([ plural($nfiles; "file")
       + (if $nfiles > $max_files then " (limit \($max_files))" else "" end),
       plural($lines; "line")
       + (if $lines > $max_lines then " (limit \($max_lines))" else "" end) ]
     + if $route == "QUICK" then
         ["no risk patterns", "no new types", "no error-flow change"]
       else
         [ (if ($risk_matches | length) > 0 then
              "touches " + ([$risk_matches[:3][] | "\(.path) (\(.patterns | join(", ")))"] | join(", "))
              + (if ($risk_matches | length) > 3 then " and \(($risk_matches | length) - 3) more" else "" end)
            else empty end),
           (if ($new_types | length) > 0 then
              "new type in " + ([$new_types[].path] | unique | join(", ")) else empty end),
           (if ($error_flow | length) > 0 then
              "error-flow change in " + ([$error_flow[].path] | unique | join(", ")) else empty end) ]
       end
     | join(", ")) as $reason
  | {route: $route, reason: $reason, line: "Routing → \($route), reason: \($reason)",
     source: {kind: $kind, value: $value},
     files: $nfiles, lines: $lines, additions: $adds, deletions: $dels,
     file_list: [$files[].path],
     risk_matches: $risk_matches, new_types: $new_types, error_flow: $error_flow,
     failed: $failed, stats_file: $stats_file, gated: $gated}
  + (if $stats_error == "" then {} else {stats_error: $stats_error} end)'
