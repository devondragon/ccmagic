#!/usr/bin/env bash
# ccm-ci-status: decide whether CI is green for a PR (or the current HEAD), as JSON.
#
# Usage:
#   ccm-ci-status [PR]                       one snapshot
#   ccm-ci-status [PR] --watch [--wait-key KEY] [--timeout-minutes N]
#                 [--interval S] [--max-call-seconds S]
#
# Status values and exit codes:
#   green           0  every check passed (skipped/neutral count as passed)
#   no-ci           0  no workflows and no required status checks: nothing to wait for
#   failed          1  at least one check failed, was cancelled, or timed out
#   pending         2  checks still running
#   not-registered  2  CI is configured but no check or run exists for this commit yet
#   conflicting     6  nothing has registered and the PR conflicts with its base;
#                      GitHub runs no pull_request workflows until that is resolved
#   unreadable      3  neither the Checks API nor the Actions/Status APIs could be read
#   timeout         5  --watch deadline passed while still pending/not-registered
#   (usage error    4)
#
# Reading order: `gh pr checks` first. A fine-grained PAT cannot read
# App-authored check runs and gets HTTP 403 there, so on 403 (or when the
# Checks API shows nothing) it reads Actions runs and legacy commit statuses
# for the head SHA instead. That fallback cannot see third-party App check
# runs; if it also fails the status is `unreadable`. When check runs are hidden
# (403) and nothing else is found, `no-ci` needs branch protection to be
# readable and show no required checks; otherwise the status is `unreadable`.
#
# Before reporting not-registered for a PR, it re-reads the PR's mergeability:
# GitHub cannot build the merge ref for a CONFLICTING PR, so its pull_request
# workflows never start, and waiting out the timeout would only hide that.
#
# Advisory checks (RV-74): when a check is not passing, it reads
# .reeve/policy.yml from the PR's base branch (never the working tree, which is
# the PR head) and sets aside every check its `ci.ignore` lists, the rule
# Reeve's merge gate applies: a listed check that failed or is still running
# neither fails nor holds the result, and an unlisted failure still does. A
# check is matched by its exact name (a check run's `name` or a status's
# `context`); an entry's `app` or `creator` is checked against the check-runs or
# statuses API, and when that is unreadable (HTTP 403) the check is set aside
# by name with `owner_unverified: true`, since Reeve checks the App again before
# it merges. Set-aside checks that had not passed are listed in `advisory` and
# named in `reason`. A missing policy lists nothing; one that cannot be read or
# parsed, or that lists a check under both `ci.required` and `ci.ignore`, also
# lists nothing and says why in `policy_note`. With nothing counted left, the
# result is decided as if no check had reported.
#
# --watch polls until the status leaves pending/not-registered. One call never
# runs longer than --max-call-seconds (default 540, under the Bash tool's
# 10-minute limit). --wait-key names a deadline file under the git dir, so the
# total wait across repeated calls is bounded by --timeout-minutes (default:
# config ci_timeout_minutes) without the caller counting anything. A call that
# returns `pending` with "call_again": true should simply be repeated.

set -euo pipefail
# shellcheck source=bin/ccm-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/ccm-lib.sh"

pr="" watch=false wait_key="" timeout_min="" interval="" max_call=540
while [ $# -gt 0 ]; do
  case $1 in
    --watch) watch=true ;;
    --wait-key) wait_key=${2:?}; shift ;;
    --timeout-minutes) timeout_min=${2:?}; shift ;;
    --interval) interval=${2:?}; shift ;;
    --max-call-seconds) max_call=${2:?}; shift ;;
    -h|--help) sed -n '2,52p' "$0"; exit 0 ;;
    -*) echo "ccm-ci-status: unknown flag $1" >&2; exit 4 ;;
    *) pr=${1#\#} ;;
  esac
  shift
done

[ -n "$timeout_min" ] || timeout_min=$(ccm_config_get ci_timeout_minutes)
[ -n "$interval" ] || interval=$(ccm_config_get ci_poll_interval_seconds)

slug=$(ccm_repo_slug)
# Set when `gh pr checks` returned a 403: App-authored check runs (including
# third-party CI) are invisible to this token, so "nothing found" can't prove
# there is no CI.
checks_hidden=false
errf=$(mktemp)
# Per-call cache: the base branch's policy (read once per call) and, per
# snapshot, the check-run Apps and status creators.
cache=$(mktemp -d)
trap 'rm -f "$errf"; rm -rf "$cache"' EXIT
ADVISORY='[]' POLICY_NOTE=""

# Resolve PR, head SHA, and base branch once.
pr_json=$(gh pr view ${pr:+"$pr"} --json number,headRefOid,baseRefName 2>/dev/null || echo null)
if [ "$pr_json" != null ]; then
  pr=$(jq -r .number <<<"$pr_json")
  sha=$(jq -r .headRefOid <<<"$pr_json")
  base=$(jq -r .baseRefName <<<"$pr_json")
else
  if [ -n "$pr" ]; then
    jq -n --arg pr "$pr" '{status:"unreadable", reason:("cannot read PR " + $pr)}'
    exit 3
  fi
  sha=$(git rev-parse HEAD)
  base=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || echo main)
fi

# Emit a result object. Args: status source reason checks_json
result() {
  jq -n --arg status "$1" --arg source "$2" --arg reason "$3" --argjson checks "${4:-[]}" \
    --arg pr "$pr" --arg sha "$sha" --arg base "$base" --argjson adv "$ADVISORY" --arg note "$POLICY_NOTE" \
    '{status: $status, source: $source,
      reason: ($reason + (if ($adv | length) > 0 then "; advisory, not counted (ci.ignore): " + ($adv | map(.name + ": " + .state) | join(", ")) else "" end)),
      pr: (if $pr == "" then null else ($pr | tonumber) end), sha: $sha, base: $base,
      checks: $checks}
     + (if ($adv | length) > 0 then {advisory: $adv} else {} end)
     + (if $note != "" then {policy_note: $note} else {} end)'
}

# The `ci` block of .reeve/policy.yml on the base branch, read once per call:
# {required, ignore}, {none: why} when there is no policy, or {error: why}.
policy_ci() {
  local f="$cache/policy" text
  if [ ! -f "$f" ]; then
    if [ -z "$slug" ]; then
      echo '{"none":"repository unknown"}' >"$f"
    elif text=$(gh api "repos/$slug/contents/.reeve/policy.yml?ref=$base" -H "Accept: application/vnd.github.raw" 2>"$cache/policy.err"); then
      ccm_policy_ci_json <<<"$text" >"$f"
    elif grep -q 'HTTP 404' "$cache/policy.err"; then
      echo '{"none":"no .reeve/policy.yml"}' >"$f"
    else
      jq -n --arg e "$(tr '\n' ' ' <"$cache/policy.err")" '{error: ("cannot read .reeve/policy.yml on the base branch: " + $e)}' >"$f"
    fi
  fi
  cat "$f"
}

# The Apps of the head's check runs (KIND check-runs) or the creators of its
# statuses (KIND statuses), as [{name, owner}], or null when unreadable.
# Cached for one snapshot.
owners() {
  local f="$cache/$1" out q
  if [ ! -f "$f" ]; then
    if [ "$1" = check-runs ]; then q='.check_runs[] | {name, owner: .app.slug}'; else q='.[] | {name: .context, owner: .creator.login}'; fi
    if out=$(gh api "repos/$slug/commits/$sha/$1?per_page=100" --paginate --jq "$q" 2>/dev/null); then
      jq -s . <<<"$out" >"$f"
    else
      echo null >"$f"
    fi
  fi
  cat "$f"
}

# Mark the checks ci.ignore sets aside with "advisory": true. Prints the checks;
# writes the policy note, if any, to $cache/note.
mark_advisory() {
  local checks=$1 pol ign runs=null sts=null
  : >"$cache/note"
  pol=$(policy_ci)
  if jq -e 'has("error")' <<<"$pol" >/dev/null; then
    jq -r '"ci.ignore not applied: " + .error' <<<"$pol" >"$cache/note"
    echo "$checks"
    return
  fi
  ign=$(jq -c '.ignore // []' <<<"$pol")
  if [ "$ign" = '[]' ]; then
    echo "$checks"
    return
  fi
  if jq -e --argjson ign "$ign" 'any(.[]; .name as $n | any($ign[]; .name == $n and .app != null))' <<<"$checks" >/dev/null; then
    runs=$(owners check-runs)
  fi
  if jq -e --argjson ign "$ign" 'any(.[]; .name as $n | any($ign[]; .context == $n and .creator != null))' <<<"$checks" >/dev/null; then
    sts=$(owners statuses)
  fi
  jq --argjson ign "$ign" --argjson runs "$runs" --argjson sts "$sts" '
    def own(list; n): [list[] | select(.name == n) | .owner];
    def held(list; n; $want): (own(list; n)) as $o | ($o | length) > 0 and all($o[]; (. // "" | ascii_downcase) == ($want | ascii_downcase));
    map(. as $c | [$ign[] |
        if .name == $c.name then
          (if .app == null then "yes" elif $runs == null then "unverified" elif held($runs; $c.name; .app) then "yes" else "no" end)
        elif .context == $c.name then
          (if .creator == null then "yes" elif $sts == null then "unverified" elif held($sts; $c.name; .creator) then "yes" else "no" end)
        else "no" end] as $m
      | if any($m[]; . == "yes") then . + {advisory: true}
        elif any($m[]; . == "unverified") then . + {advisory: true, owner_unverified: true}
        else . end)
  ' <<<"$checks"
}

# No check or run for this SHA: is there CI that should have produced one?
no_checks_verdict() {
  local root has_workflows=false required=unknown code
  root=$(git rev-parse --show-toplevel)
  if compgen -G "$root/.github/workflows/*.yml" >/dev/null || compgen -G "$root/.github/workflows/*.yaml" >/dev/null; then
    has_workflows=true
  fi
  if [ -n "$slug" ]; then
    if out=$(gh api "repos/$slug/branches/$base/protection/required_status_checks" 2>"$errf"); then
      if [ "$(jq '(.contexts // []) + (.checks // []) | length' <<<"$out")" -gt 0 ]; then
        required=true
      else
        required=false
      fi
    elif grep -q 'HTTP 404' "$errf"; then
      required=false
    fi
  fi
  if [ "$has_workflows" = false ] && [ "$required" = unknown ] && [ "$checks_hidden" = true ]; then
    result unreadable none "check runs are not readable with this token (HTTP 403) and branch protection on $base could not be read, so CI can't be ruled out"
  elif [ "$has_workflows" = false ] && [ "$required" != true ]; then
    result no-ci none "no workflow files and no required status checks on $base"
  else
    code=$([ "$has_workflows" = true ] && echo "workflow files exist" || echo "required status checks exist")
    if [ -n "$pr" ] && [ "$(gh pr view "$pr" --json mergeable -q .mergeable 2>/dev/null || true)" = CONFLICTING ]; then
      result conflicting none "PR #$pr has merge conflicts with $base, so GitHub will not run its pull_request workflows; nothing has registered for $sha ($code)"
      return
    fi
    result not-registered none "CI is configured ($code) but nothing has registered for $sha yet"
  fi
}

# Actions runs + legacy commit statuses for the head SHA.
actions_verdict() {
  local runs statuses
  if ! runs=$(gh run list --commit "$sha" --json databaseId,workflowName,status,conclusion 2>"$errf"); then
    runs=""
  fi
  statuses=""
  if [ -n "$slug" ]; then
    statuses=$(gh api "repos/$slug/commits/$sha/status" 2>>"$errf" || true)
  fi
  if [ -z "$runs" ] && [ -z "$statuses" ]; then
    result unreadable actions-fallback "cannot read CI status: $(tr '\n' ' ' <"$errf")"
    return
  fi
  [ -n "$runs" ] || runs='[]'
  [ -n "$statuses" ] || statuses='{"state":"pending","total_count":0,"statuses":[]}'
  local checks
  checks=$(jq -n --argjson runs "$runs" --argjson st "$statuses" '
    ($runs | map({name: .workflowName, state: (.conclusion // .status),
      bucket: (if .status != "completed" then "pending"
               elif (.conclusion | IN("success","skipped","neutral")) then "pass"
               else "fail" end)}))
    + ($st.statuses // [] | map({name: .context, state: .state,
      bucket: (if .state == "success" then "pass" elif .state == "pending" then "pending" else "fail" end)}))
  ')
  if [ "$(jq length <<<"$checks")" -eq 0 ]; then
    no_checks_verdict
  else
    verdict_from_buckets actions-fallback "$checks"
  fi
}

verdict_from_buckets() {
  local source=$1 checks=$2 shown=$2
  # Only a check that is not passing can change the verdict, so the policy is
  # read only then. `shown` keeps every check, the advisory ones marked.
  if jq -e 'any(.[]; .bucket | IN("pass", "skipping") | not)' <<<"$checks" >/dev/null; then
    shown=$(mark_advisory "$checks")
    POLICY_NOTE=$(cat "$cache/note")
    ADVISORY=$(jq -c '[.[] | select(.advisory and (.bucket | IN("pass", "skipping") | not)) | {name, state, bucket} + (if .owner_unverified then {owner_unverified: true} else {} end)]' <<<"$shown")
    checks=$(jq -c 'map(select(.advisory | not))' <<<"$shown")
    if [ "$checks" = '[]' ]; then
      no_checks_verdict
      return
    fi
  fi
  if jq -e 'any(.bucket == "fail" or .bucket == "cancel")' <<<"$checks" >/dev/null; then
    result failed "$source" "failing: $(jq -r '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' <<<"$checks")" "$shown"
  elif jq -e 'any(.bucket == "pending")' <<<"$checks" >/dev/null; then
    result pending "$source" "running: $(jq -r '[.[] | select(.bucket == "pending") | .name] | join(", ")' <<<"$checks")" "$shown"
  else
    result green "$source" "$(if [ "$ADVISORY" = '[]' ]; then echo "all checks passed"; else echo "all counted checks passed"; fi)" "$shown"
  fi
}

snapshot() {
  local out _
  rm -f "$cache/check-runs" "$cache/statuses"
  if [ -z "$pr" ]; then
    actions_verdict
    return
  fi
  for _ in 1 2; do
    : >"$errf"
    out=$(gh pr checks "$pr" --json name,state,bucket,workflow 2>"$errf") || true
    if [ -n "$out" ] && jq -e 'type == "array"' <<<"$out" >/dev/null 2>&1; then
      if [ "$(jq length <<<"$out")" -gt 0 ]; then
        verdict_from_buckets checks "$(jq '[.[] | {name, state, bucket}]' <<<"$out")"
      else
        actions_verdict
      fi
      return
    fi
    if grep -qi 'no checks reported' "$errf"; then
      actions_verdict
      return
    fi
    if grep -qiE 'HTTP 403|Resource not accessible' "$errf"; then
      checks_hidden=true
      actions_verdict
      return
    fi
    # Any other failure: one retry, then fall back to the Actions/Status APIs.
  done
  actions_verdict
}

exit_for() {
  case $1 in
    green|no-ci) echo 0 ;;
    failed) echo 1 ;;
    pending|not-registered) echo 2 ;;
    unreadable) echo 3 ;;
    timeout) echo 5 ;;
    conflicting) echo 6 ;;
    *) echo 3 ;;
  esac
}

if [ "$watch" = false ]; then
  r=$(snapshot)
  echo "$r"
  exit "$(exit_for "$(jq -r .status <<<"$r")")"
fi

now=$(date +%s)
if [ -n "$wait_key" ]; then
  dfile="$(ccm_state_dir)/ci-wait-$wait_key"
  if [ -f "$dfile" ]; then
    deadline=$(cat "$dfile")
  else
    deadline=$((now + timeout_min * 60))
    echo "$deadline" >"$dfile"
  fi
else
  deadline=$((now + timeout_min * 60))
fi
call_end=$((now + max_call))

while :; do
  r=$(snapshot)
  status=$(jq -r .status <<<"$r")
  case $status in
    pending|not-registered) ;;
    *) [ -z "$wait_key" ] || rm -f "$dfile"; echo "$r"; exit "$(exit_for "$status")" ;;
  esac
  now=$(date +%s)
  if [ "$now" -ge "$deadline" ]; then
    [ -z "$wait_key" ] || rm -f "$dfile"
    jq --arg m "$timeout_min" '.status = "timeout" | .reason = ("still " + .reason + " after " + $m + " minutes")' <<<"$r"
    exit 5
  fi
  if [ $((now + interval)) -ge "$call_end" ]; then
    jq --argjson left $((deadline - now)) '. + {call_again: true, deadline_remaining_seconds: $left}' <<<"$r"
    exit 2
  fi
  sleep "$interval"
done
