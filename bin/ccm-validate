#!/usr/bin/env bash
# ccm-validate: run the project's format, lint, types, test, and build checks, as JSON.
#
# Usage: ccm-validate [--only CHECK[,CHECK...]] [--list]
#        ccm-validate --install
#
#   --only     run only these checks (format, lint, types, test, build)
#   --list     print the resolved commands without running them
#   --install  only install missing Node dependencies (below), run no check
#
# Each check has at most one command, and its exit code is the verdict. The
# command comes from config key validate_<check> (a value of `none` disables
# the check), or, when the key is absent, from detection: package.json scripts
# (run with pnpm, yarn, or npm by lockfile), Makefile targets, go.mod,
# Cargo.toml, or pyproject.toml tools that are configured. A check with no
# command is skipped as "not configured".
#
# Gradle (build.gradle, build.gradle.kts, or settings.gradle*) and Maven
# (pom.xml) builds are detected too, run through ./gradlew or ./mvnw when the
# wrapper exists and gradle or mvn otherwise. When a JVM build is present it
# is the repo's primary build, so it supplies test (`gradle test`,
# `mvn -B test`) and build (`gradle build`, `mvn -B verify`) ahead of
# package.json and the Makefile. It supplies no lint or types command, so
# package.json scripts (then the Makefile) still supply format, lint, and
# types; Gradle adds `spotlessCheck` for format when the root build file
# applies the Spotless plugin and nothing earlier supplied format. Maven's
# build check is `verify` because, like Gradle's `build`, it runs every
# verification the build defines (tests included), not only packaging.
#
# Each command runs from the repo root under `timeout` (or `gtimeout`) with
# validate_timeout_seconds (default 540); a check that hits it fails as
# "timed out". With neither binary installed, checks run unbounded and the
# output says so in `note`. Full output goes to a log file under the git dir;
# a failed check also carries its last 40 lines as `tail`.
#
# Missing Node dependencies (Node only; no other ecosystem is installed):
# when the root package.json declares dependencies (or workspaces), there is
# no Yarn Plug'n'Play map (.pnp.cjs, .pnp.js), and a package it needs is not
# installed (deps_missing below says which count), the first check that runs is preceded by the install its lockfile calls for:
# `pnpm install --frozen-lockfile` (pnpm-lock.yaml), `yarn install
# --frozen-lockfile` (yarn.lock; `--immutable` with .yarnrc.yml), `bun install
# --frozen-lockfile` (bun.lock, bun.lockb), or `npm ci` (package-lock.json,
# npm-shrinkwrap.json), under the same time limit as a check, with its output
# in install.log. With no lockfile, or without the lockfile's tool installed,
# nothing is installed. An install that fails, times out, or cannot be done is
# an environment problem, not a check failure: no check runs, and the status
# is `environment`. The output's `install` object says what happened
# ({tool, command, status: planned | installed | failed | unavailable,
# duration_s?, log?, reason?, tail?}); it is absent when nothing was needed.
#
# Output: {status, timeout_seconds, install?, checks: [{name, command, source,
# status, exit_code, duration_s, log, reason?, tail?}]}
#
# Status values and exit codes:
#   pass            0  every check that ran passed
#   fail            1  at least one check failed or timed out
#   nothing-to-run  2  every check was skipped
#   listed          0  (--list) at least one check would run
#   environment     5  missing dependencies could not be installed; no check ran
#   installed       0  (--install) the dependencies were installed
#   not-needed      0  (--install) nothing to install
#   (not a git repository 3, usage error 4)

set -euo pipefail
# shellcheck source=bin/ccm-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/ccm-lib.sh"

ALL_CHECKS="format lint types test build"

only="" list=false install_only=false
while [ $# -gt 0 ]; do
  case $1 in
    --only) only=${2:-}; [ -n "$only" ] || { echo "ccm-validate: --only needs a value" >&2; exit 4; }; shift ;;
    --list) list=true ;;
    --install) install_only=true ;;
    -h|--help) sed -n '2,62p' "$0"; exit 0 ;;
    *) echo "ccm-validate: unknown argument $1" >&2; exit 4 ;;
  esac
  shift
done
if [ "$install_only" = true ] && { [ -n "$only" ] || [ "$list" = true ]; }; then
  echo "ccm-validate: --install takes no other option" >&2; exit 4
fi

checks=$ALL_CHECKS
if [ -n "$only" ]; then
  checks=""
  for c in ${only//,/ }; do
    case " $ALL_CHECKS " in
      *" $c "*) checks="$checks $c" ;;
      *) echo "ccm-validate: unknown check '$c' (expected one of: $ALL_CHECKS)" >&2; exit 4 ;;
    esac
  done
fi

if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo '{"error":"not a git repository"}'
  exit 3
fi
cd "$root"

config=$(ccm_config_json)
timeout_s=$(jq -r '.validate_timeout_seconds' <<<"$config")
case $timeout_s in
  ''|*[!0-9]*) echo "ccm-validate: validate_timeout_seconds must be a whole number, got '$timeout_s'" >&2; exit 4 ;;
esac

# ---- detection -------------------------------------------------------------

pm=npm
if [ -f pnpm-lock.yaml ]; then pm=pnpm; elif [ -f yarn.lock ]; then pm=yarn; fi

pkg_script() {
  [ -f package.json ] || return 1
  jq -e --arg s "$1" '.scripts[$s] // empty' package.json >/dev/null 2>&1
}

make_target() {
  [ -f Makefile ] || return 1
  grep -Eq "^$1[[:space:]]*:" Makefile
}

# pyproject.toml tool is configured: a [tool.NAME] table or one of its files.
py_tool() {
  local name=$1; shift
  [ -f pyproject.toml ] || return 1
  grep -Eq "^\[tool\.$name([].])" pyproject.toml && return 0
  local f
  for f in "$@"; do [ -f "$f" ] && return 0; done
  return 1
}

# The JVM build tool command, or nothing: Gradle first, then Maven. A wrapper
# that isn't executable (lost its mode bit) still runs through sh.
jvm=""
if [ -f build.gradle ] || [ -f build.gradle.kts ] || [ -f settings.gradle ] || [ -f settings.gradle.kts ]; then
  jvm=gradle
  if [ -x gradlew ]; then jvm=./gradlew; elif [ -f gradlew ]; then jvm="sh ./gradlew"; fi
elif [ -f pom.xml ]; then
  jvm=mvn
  if [ -x mvnw ]; then jvm=./mvnw; elif [ -f mvnw ]; then jvm="sh ./mvnw"; fi
fi

# The root Gradle build file applies the Spotless plugin.
gradle_spotless() {
  case $jvm in *gradle*) ;; *) return 1 ;; esac
  local f
  for f in build.gradle build.gradle.kts; do
    [ -f "$f" ] && grep -q 'com\.diffplug\.spotless' "$f" && return 0
  done
  return 1
}

# Print the detected command for a check, or nothing.
detect() {
  local check=$1 s
  if [ -n "$jvm" ]; then
    case $jvm:$check in
      *gradle*:test) echo "$jvm test"; return ;;
      *gradle*:build) echo "$jvm build"; return ;;
      *:test) echo "$jvm -B test"; return ;;
      *:build) echo "$jvm -B verify"; return ;;
    esac
  fi
  case $check in
    format) pkg_script format:check && { echo "$pm run format:check"; return; } ;;
    lint) pkg_script lint && { echo "$pm run lint"; return; } ;;
    types) for s in typecheck type-check; do pkg_script "$s" && { echo "$pm run $s"; return; }; done ;;
    test) pkg_script test && { echo "$pm run test"; return; } ;;
    build) pkg_script build && { echo "$pm run build"; return; } ;;
  esac
  case $check in
    format) make_target format-check && { echo "make format-check"; return; } ;;
    types) for s in typecheck type-check; do make_target "$s" && { echo "make $s"; return; }; done ;;
    *) make_target "$check" && { echo "make $check"; return; } ;;
  esac
  if [ "$check" = format ] && gradle_spotless; then
    echo "$jvm spotlessCheck"; return
  fi
  if [ -f go.mod ]; then
    # shellcheck disable=SC2016 # $out is expanded by the bash -c that runs it
    case $check in
      format) echo 'out=$(gofmt -l .) && printf "%s" "$out" && test -z "$out"'; return ;;
      lint) echo 'go vet ./...'; return ;;
      test) echo 'go test ./...'; return ;;
      build) echo 'go build ./...'; return ;;
    esac
  fi
  if [ -f Cargo.toml ]; then
    case $check in
      format) echo 'cargo fmt -- --check'; return ;;
      lint) echo 'cargo clippy -- -D warnings'; return ;;
      test) echo 'cargo test'; return ;;
      build) echo 'cargo build'; return ;;
    esac
  fi
  case $check in
    format) py_tool ruff ruff.toml .ruff.toml && { echo 'ruff format --check'; return; } ;;
    lint) py_tool ruff ruff.toml .ruff.toml && { echo 'ruff check'; return; } ;;
    types) py_tool mypy mypy.ini .mypy.ini && { echo 'mypy .'; return; } ;;
    test) py_tool 'pytest' pytest.ini && { echo 'pytest'; return; } ;;
  esac
  return 0
}

timeout_bin=""
if command -v timeout >/dev/null 2>&1; then
  timeout_bin=timeout
elif command -v gtimeout >/dev/null 2>&1; then
  timeout_bin=gtimeout
fi

logdir=""
ensure_logdir() { [ -n "$logdir" ] || { logdir="$(ccm_state_dir)/validate"; mkdir -p "$logdir"; }; }

# run_bounded CMD LOG: run CMD from the repo root under the time limit, output
# to LOG, and return its exit code.
run_bounded() {
  local rc
  set +e
  if [ -n "$timeout_bin" ]; then
    "$timeout_bin" --kill-after=10 "$timeout_s" bash -c "$1" >"$2" 2>&1 </dev/null
  else
    bash -c "$1" >"$2" 2>&1 </dev/null
  fi
  rc=$?
  set -e
  return "$rc"
}

# timeout exits 124 on SIGTERM and 137 when --kill-after had to SIGKILL.
timed_out() { [ -n "$timeout_bin" ] && { [ "$1" -eq 124 ] || [ "$1" -eq 137 ]; }; }

# ---- missing Node dependencies ---------------------------------------------

# The root package.json declares dependencies or workspaces, there is no Yarn
# Plug'n'Play map, and a package it needs is not installed: a name under
# `dependencies` or `devDependencies` with no node_modules/<name>, or, when it
# declares only optional or peer dependencies or workspaces, no node_modules
# at all. A bare node_modules directory is not enough: `npx vitest` in a
# checkout with nothing installed leaves node_modules/.vite behind (Reeve's
# RS-193, 2026-10-06).
deps_missing() {
  [ -f package.json ] || return 1
  { [ -f .pnp.cjs ] || [ -f .pnp.js ]; } && return 1
  local names name
  names=$(jq -r '[.dependencies, .devDependencies] | map(objects | keys[]) | .[]' package.json 2>/dev/null) || return 1
  if [ -n "$names" ]; then
    while IFS= read -r name; do
      [ -e "node_modules/$name" ] || return 0
    done <<<"$names"
    return 1
  fi
  [ -d node_modules ] && return 1
  jq -e '([.optionalDependencies, .peerDependencies] | map(objects | length) | add) > 0
    or has("workspaces")' package.json >/dev/null 2>&1
}

# The install the lockfile calls for, in the same order the checks pick their
# package manager. Sets install_tool, install_cmd, and, when it cannot run,
# install_reason.
install_tool="" install_cmd="" install_reason=""
plan_install() {
  local lock
  if [ -f pnpm-lock.yaml ]; then
    lock=pnpm-lock.yaml install_tool=pnpm install_cmd="pnpm install --frozen-lockfile"
  elif [ -f yarn.lock ]; then
    lock=yarn.lock install_tool=yarn install_cmd="yarn install --frozen-lockfile"
    [ -f .yarnrc.yml ] && install_cmd="yarn install --immutable"
  elif [ -f bun.lock ] || [ -f bun.lockb ]; then
    lock=bun.lock install_tool=bun install_cmd="bun install --frozen-lockfile"
    [ -f bun.lock ] || lock=bun.lockb
  elif [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then
    lock=package-lock.json install_tool=npm install_cmd="npm ci"
    [ -f package-lock.json ] || lock=npm-shrinkwrap.json
  else
    install_reason="package.json declares dependencies and node_modules is missing, but there is no lockfile, so ccm-validate does not install them"
    return
  fi
  command -v "$install_tool" >/dev/null 2>&1 ||
    install_reason="node_modules is missing and $install_tool is not installed, so the dependencies $lock calls for cannot be installed"
}

install_json="" install_state=none   # none | planned | installed | failed
need_install=false
if deps_missing; then
  need_install=true
  plan_install
fi

# install_info STATUS [KEY VALUE...]: the install object, as JSON.
install_info() {
  local st=$1; shift
  # shellcheck disable=SC2016 # jq variables, expanded by jq
  local args=(--arg st "$st" --arg tool "$install_tool" --arg cmd "$install_cmd") f='{tool: (if $tool == "" then null else $tool end), command: (if $cmd == "" then null else $cmd end), status: $st}'
  while [ $# -gt 0 ]; do
    case $1 in
      duration_s) args+=(--argjson "$1" "$2"); f+=" + {$1: \$$1}" ;;
      *) args+=(--arg "$1" "$2"); f+=" + {$1: \$$1}" ;;
    esac
    shift 2
  done
  jq -cn "${args[@]}" "$f"
}

# Install the dependencies. Sets install_json and install_state.
do_install() {
  if [ -n "$install_reason" ]; then
    install_json=$(install_info unavailable reason "$install_reason")
    install_state=failed
    return
  fi
  ensure_logdir
  local log="$logdir/install.log" start rc duration
  start=$(date +%s)
  run_bounded "$install_cmd" "$log" && rc=0 || rc=$?
  duration=$(($(date +%s) - start))
  if [ "$rc" -eq 0 ]; then
    install_json=$(install_info installed duration_s "$duration" log "$log")
    install_state=installed
    return
  fi
  local reason="$install_cmd exited $rc"
  timed_out "$rc" && reason="$install_cmd timed out after ${timeout_s}s"
  install_json=$(install_info failed duration_s "$duration" log "$log" reason "$reason" tail "$(tail -n 40 "$log")")
  install_state=failed
}

# no_timeout_note: the note for output when no timeout binary bounded a run.
no_timeout_note() { echo "neither timeout nor gtimeout is installed (brew install coreutils), so checks run without a time limit"; }

if [ "$install_only" = true ]; then
  if [ "$need_install" = false ]; then
    jq -n --argjson t "$timeout_s" '{status: "not-needed", timeout_seconds: $t}'
    exit 0
  fi
  do_install
  status=installed rc=0
  [ "$install_state" = installed ] || { status=environment rc=5; }
  note=""
  [ -n "$timeout_bin" ] || [ -n "$install_reason" ] || note=$(no_timeout_note)
  jq -n --arg status "$status" --argjson t "$timeout_s" --argjson i "$install_json" --arg note "$note" \
    '{status: $status, timeout_seconds: $t, install: $i} + (if $note == "" then {} else {note: $note} end)'
  exit "$rc"
fi

# ---- resolve and run -------------------------------------------------------

results=()
ran=0 failed=0

for check in $checks; do
  cmd=$(jq -r --arg k "validate_$check" '.[$k] // ""' <<<"$config")
  source=config
  if [ -z "$cmd" ]; then
    cmd=$(detect "$check")
    source=detected
  fi

  if [ "$cmd" = none ]; then
    results+=("$(jq -n --arg n "$check" \
      '{name: $n, command: null, source: "config", status: "skipped", reason: "disabled in config"}')")
    continue
  fi
  if [ -z "$cmd" ]; then
    results+=("$(jq -n --arg n "$check" \
      '{name: $n, command: null, source: null, status: "skipped", reason: "not configured"}')")
    continue
  fi

  ran=$((ran + 1))
  if [ "$list" = true ]; then
    results+=("$(jq -n --arg n "$check" --arg c "$cmd" --arg s "$source" \
      '{name: $n, command: $c, source: $s, status: "planned"}')")
    continue
  fi

  if [ "$need_install" = true ] && [ "$install_state" = none ]; then
    do_install
  fi
  if [ "$install_state" = failed ]; then
    results+=("$(jq -n --arg n "$check" --arg c "$cmd" --arg s "$source" \
      '{name: $n, command: $c, source: $s, status: "skipped", reason: "dependencies are not installed"}')")
    continue
  fi

  ensure_logdir
  log="$logdir/$check.log"
  start=$(date +%s)
  run_bounded "$cmd" "$log" && rc=0 || rc=$?
  duration=$(($(date +%s) - start))

  if [ "$rc" -eq 0 ]; then
    results+=("$(jq -n --arg n "$check" --arg c "$cmd" --arg s "$source" --arg l "$log" \
      --argjson d "$duration" \
      '{name: $n, command: $c, source: $s, status: "passed", exit_code: 0, duration_s: $d, log: $l}')")
  else
    failed=$((failed + 1))
    reason=""
    if timed_out "$rc"; then
      reason="timed out after ${timeout_s}s"
    fi
    results+=("$(jq -n --arg n "$check" --arg c "$cmd" --arg s "$source" --arg l "$log" \
      --argjson rc "$rc" --argjson d "$duration" --arg r "$reason" --arg tail "$(tail -n 40 "$log")" \
      '{name: $n, command: $c, source: $s, status: "failed", exit_code: $rc, duration_s: $d, log: $l}
       + (if $r == "" then {} else {reason: $r} end) + {tail: $tail}')")
  fi
done

if [ "$install_state" = failed ]; then
  status=environment rc=5
elif [ "$ran" -eq 0 ]; then
  status=nothing-to-run rc=2
elif [ "$list" = true ]; then
  status=listed rc=0
elif [ "$failed" -gt 0 ]; then
  status=fail rc=1
else
  status=pass rc=0
fi

# --list shows the install the first check would be preceded by.
if [ "$list" = true ] && [ "$need_install" = true ] && [ "$ran" -gt 0 ]; then
  if [ -n "$install_reason" ]; then
    install_json=$(install_info unavailable reason "$install_reason")
  else
    install_json=$(install_info planned)
  fi
fi

note=""
if [ -z "$timeout_bin" ] && [ "$ran" -gt 0 ]; then
  note=$(no_timeout_note)
fi

printf '%s\n' "${results[@]}" | jq -s --arg status "$status" --arg note "$note" --argjson t "$timeout_s" \
  --arg install "$install_json" \
  '{status: $status, timeout_seconds: $t} + (if $install == "" then {} else {install: ($install | fromjson)} end)
   + {checks: .} + (if $note == "" then {} else {note: $note} end)'
exit "$rc"
