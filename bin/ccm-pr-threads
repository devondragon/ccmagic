#!/usr/bin/env bash
# ccm-pr-threads: a PR's review threads, reviews, and conversation comments, as JSON.
#
# Usage: ccm-pr-threads [PR] [--since-id N]
#
#   PR           defaults to the current branch's PR
#   --since-id N mark review comments with an id above N as new (N is a
#                max_review_comment_id from an earlier call)
#
# Output:
#   pr, author                 PR number and author login
#   max_review_comment_id      highest review-comment id; pass it back as --since-id
#   threads[]                  {id, is_resolved, is_outdated, path, line, open, has_new,
#                               disposition, disposition_commit, fix_verified,
#                               comments[{id, author, by_author, created_at, url, body}]}
#   open_thread_count          threads that are not handled (see below)
#   new_comment_count          review comments above --since-id not by the PR author
#   reviews[]                  {id, author, state, submitted_at, body}
#   issue_comments[]           {id, author, by_author, created_at, body}
#   truncated                  true if a page limit was hit (100 threads, 50 comments
#                              per thread, 100 reviews, 100 issue comments)
#
# A thread is handled (open: false) when it is resolved, or when the last
# comment is the PR author's and carries a disposition marker, which
# bin/ccm-pr-reply appends to every reply it posts:
#
#   <!-- ccmagic:disposition=declined -->
#   <!-- ccmagic:disposition=answered -->
#   <!-- ccmagic:disposition=deferred ticket=ENG-412 -->
#   <!-- ccmagic:disposition=fixed commit=<sha> -->
#
# `fixed` counts only when the commit is verified in the local clone: it is an
# ancestor of the PR head (or of HEAD if the head isn't fetched), it is not
# already contained in the commit the review comment was made on, and it
# touches the thread's file. An author reply with no marker ("will fix")
# leaves the thread open.
#
# Exit codes: 0 ok, 3 cannot read the PR, 4 usage error.

set -euo pipefail
# shellcheck source=bin/ccm-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/ccm-lib.sh"

pr="" since=0
while [ $# -gt 0 ]; do
  case $1 in
    --since-id)
      since=${2:-}
      case $since in ''|*[!0-9]*) echo "ccm-pr-threads: --since-id needs a non-negative integer" >&2; exit 4 ;; esac
      shift
      ;;
    -h|--help) sed -n '2,38p' "$0"; exit 0 ;;
    -*) echo "ccm-pr-threads: unknown flag $1" >&2; exit 4 ;;
    *) pr=${1#\#} ;;
  esac
  shift
done

if [ -z "$pr" ]; then
  pr=$(gh pr view --json number -q .number 2>/dev/null || true)
fi
slug=$(ccm_repo_slug)
if [ -z "$pr" ] || [ -z "$slug" ]; then
  jq -n '{error: "cannot determine the PR or the repository"}'
  exit 3
fi

# shellcheck disable=SC2016  # GraphQL variables, not shell
query='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      number
      headRefOid
      author { login }
      reviewThreads(first: 100) {
        pageInfo { hasNextPage }
        nodes {
          id isResolved isOutdated path line
          comments(first: 50) {
            pageInfo { hasNextPage }
            nodes { databaseId author { login } body createdAt url originalCommit { oid } }
          }
        }
      }
      reviews(first: 100) {
        pageInfo { hasNextPage }
        nodes { databaseId author { login } state submittedAt body }
      }
      comments(first: 100) {
        pageInfo { hasNextPage }
        nodes { databaseId author { login } body createdAt }
      }
    }
  }
}'

if ! raw=$(gh api graphql -f query="$query" -F owner="${slug%%/*}" -F name="${slug##*/}" -F number="$pr" 2>&1); then
  jq -n --arg e "$raw" --arg pr "$pr" '{error: ("cannot read PR " + $pr + ": " + $e)}'
  exit 3
fi

# Last comment of each thread, if it is the author's and carries a marker.
markers=$(jq '
  .data.repository.pullRequest as $p
  | ($p.author.login // "") as $author
  | [$p.reviewThreads.nodes[]
     | . as $t
     | ($t.comments.nodes | last) as $last
     | select($last != null and ($last.author.login // "") == $author)
     | ($last.body | capture("<!-- ccmagic:disposition=(?<d>fixed|declined|answered|deferred)(?<rest>[^>]*)-->")?) as $m
     | select($m != null)
     | {id: $t.id, disposition: $m.d,
        commit: ([$m.rest | capture("commit=(?<c>[0-9a-fA-F]{7,40})")?.c] | first),
        path: $t.path,
        base: ($t.comments.nodes[0].originalCommit.oid // null)}]
' <<<"$raw")

# Verify `fixed` markers against the local clone.
head=$(jq -r '.data.repository.pullRequest.headRefOid // empty' <<<"$raw")
git cat-file -e "${head:-x}^{commit}" 2>/dev/null || head=HEAD
verified='{}'
while IFS=$'\t' read -r id commit path base; do
  [ -n "$id" ] || continue
  ok=false
  if [ -n "$commit" ] && git cat-file -e "$commit^{commit}" 2>/dev/null &&
     git merge-base --is-ancestor "$commit" "$head" 2>/dev/null; then
    ok=true
    if [ -n "$base" ] && git cat-file -e "$base^{commit}" 2>/dev/null &&
       git merge-base --is-ancestor "$commit" "$base" 2>/dev/null; then
      ok=false   # the "fix" was already there when the reviewer commented
    fi
    if [ "$ok" = true ] && [ -n "$path" ] &&
       ! git diff-tree --no-commit-id --name-only -r "$commit" | grep -qxF -- "$path"; then
      ok=false
    fi
  fi
  verified=$(jq --arg id "$id" --argjson ok "$ok" '. + {($id): $ok}' <<<"$verified")
done < <(jq -r '.[] | select(.disposition == "fixed") | [.id, (.commit // ""), (.path // ""), (.base // "")] | @tsv' <<<"$markers")

jq --argjson since "$since" --argjson markers "$markers" --argjson verified "$verified" '
  .data.repository.pullRequest as $p
  | ($p.author.login // "") as $author
  | ($markers | map({(.id): .}) | add // {}) as $mk
  | def login: (.author.login // "ghost");
    ($p.reviewThreads.nodes | map(
      (.comments.nodes | map({id: .databaseId, author: login, by_author: (login == $author),
                              created_at: .createdAt, url, body})) as $c
      | ($mk[.id]) as $m
      | ($m != null and ($m.disposition != "fixed" or ($verified[.id] // false))) as $marked
      | {id, is_resolved: .isResolved, is_outdated: .isOutdated, path, line,
         open: ((.isResolved | not) and ($c | length > 0) and ($marked | not)),
         has_new: any($c[]; .id > $since and (.by_author | not)),
         disposition: ($m.disposition // null),
         disposition_commit: ($m.commit // null),
         fix_verified: (if ($m.disposition // "") == "fixed" then ($verified[.id] // false) else null end),
         comments: $c})) as $threads
  | {
      pr: $p.number,
      author: $author,
      max_review_comment_id: ([$threads[].comments[].id] | max // 0),
      threads: $threads,
      open_thread_count: ($threads | map(select(.open)) | length),
      new_comment_count: ([$threads[].comments[] | select(.id > $since and (.by_author | not))] | length),
      reviews: ($p.reviews.nodes | map({id: .databaseId, author: login, state, submitted_at: .submittedAt, body})),
      issue_comments: ($p.comments.nodes | map({id: .databaseId, author: login, by_author: (login == $author),
                                               created_at: .createdAt, body})),
      truncated: ($p.reviewThreads.pageInfo.hasNextPage or $p.reviews.pageInfo.hasNextPage
                  or $p.comments.pageInfo.hasNextPage
                  or any($p.reviewThreads.nodes[]; .comments.pageInfo.hasNextPage))
    }
' <<<"$raw"
